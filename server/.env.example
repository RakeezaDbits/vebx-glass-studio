PORT=3001
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=vebx_studio

JWT_SECRET=change-me-to-a-long-random-string

# Trust X-Forwarded-For for real client IP (visit analytics / geoip). Set TRUST_PROXY=0 only if you must not trust the proxy chain.
# TRUST_PROXY=0

# AI Design idea: daily credits per device (optional, default 5)
AI_CHAT_DAILY_CREDITS=5

# OpenAI API Key (required for AI chat, image gen, voice)
OPEN_API_KEY=sk-your-openai-key-here

# ---------------------------------------------------------------------------
# Self-hosted visit analytics (dashboard charts — site_visits table)
# ---------------------------------------------------------------------------
# Each public page view: server records client IP (from X-Forwarded-For when
# trust proxy is on), country (GeoIP + CDN headers), path, visitor_key.
# No extra keys needed. Ensure Node serves /api and DB can CREATE site_visits.
# If static hosting has no /api proxy, set apiBase in public/api-config.json after build.
#
# Force the admin dashboard to read only MySQL (skip GA4 even if configured):
# ANALYTICS_DASHBOARD_SOURCE=mysql

# ---------------------------------------------------------------------------
# Optional — Google Analytics 4 (Analytics Data API)
# ---------------------------------------------------------------------------
# When GA4_PROPERTY_ID + credentials are set and API succeeds, the admin
# dashboard uses Google Analytics 4 (screenPageViews, activeUsers, countryId).
# Otherwise it uses MySQL site_visits (self-hosted). Use ANALYTICS_DASHBOARD_SOURCE=mysql
# to always use the visit log instead.
#
# Your web tag (e.g. G-KJGZND4KYS) is NOT the Property ID. In GA4: Admin →
# Property settings → top of page: "PROPERTY ID" (digits only). Use that below.
#
# 1) Google Cloud → enable "Google Analytics Data API" for the same project as the service account.
# 2) IAM → Service accounts → Keys → JSON (never commit the real file).
# 3) GA4 → Admin → Property access management → add service account email as Viewer.
#
# Pick ONE auth style:

# Numeric GA4 Property ID only:
# GA4_PROPERTY_ID=123456789

# A) Absolute path to service account JSON on the server (recommended):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account.json

# B) OR single-line minified JSON (paste your whole key as one line — keep out of git):
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}

# OAuth web client — NOT for GA4 server reports; only if you build a separate Google login flow:
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-secret

# ---------------------------------------------------------------------------
# Social media automation (admin → Social automation)
# ---------------------------------------------------------------------------
# Copy these into server/.env and fill real values. Restart PM2 / Node after changes.
# The admin UI shows set/empty only — never the secret values.

# --- Facebook (Meta Graph API) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# --- Instagram Business (via Meta; often same system user token as the Page) ---
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- LinkedIn (Marketing / REST) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=

# --- Twitter / X (API v2) ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
